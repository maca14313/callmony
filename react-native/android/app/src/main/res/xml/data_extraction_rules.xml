<?xml version="1.0" encoding="utf-8"?>
<!-- v1.6.3 — data extraction rules (Android 12+). Same policy as
     backup_rules.xml: the AsyncStorage ledger database, the local safety
     snapshots and preferences are carried to cloud backup AND device-to-device
     transfers. Only included domains are extracted — cache never leaves the
     phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
